# ─────────────────────────────────────────────────────────────────────────────
# BioPharma BD Platform — environment
# Copy to .env.local for Next.js and .env for scripts. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Database ───────────────────────────────────────────────────────────────────
# If DATABASE_URL is set, the app uses Postgres (postgres-js driver).
# If it is empty, the app falls back to an embedded PGlite database written to
# ./.pglite so the platform runs with zero external services — LOCAL DEV ONLY.
#
# Deploying to Vercel / Netlify / Lambda / Cloud Run: DATABASE_URL is REQUIRED.
# Those hosts have no persistent writable filesystem; the app refuses the PGlite
# fallback there and asks you to set this. Set REQUIRE_POSTGRES=1 to enforce the
# same on any other host.
DATABASE_URL=
# DATABASE_URL=postgres://user:password@localhost:5432/oncology_bd
PGLITE_DATA_DIR=./.pglite
# REQUIRE_POSTGRES=1

# LLM provider abstraction ───────────────────────────────────────────────────
# LLM_PROVIDER: anthropic | openai | mock   (mock = deterministic, no network)
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ClinicalTrials.gov (API v2 — no key required) ──────────────────────────────
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICALTRIALS_USER_AGENT=oncology-bd-platform/0.1 (contact: you@example.com)

# Publication sources (MVP 2 — adapters ship disabled until configured) ───────
NCBI_API_KEY=
CROSSREF_MAILTO=you@example.com

# Salesforce (MVP 3) ────────────────────────────────────────────────────────
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/crm/salesforce/callback

# Email / calendar (MVP 4) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background job endpoints ──────────────────────────────────────────────────
# Shared secret required in the x-cron-secret header to trigger /api/cron/*.
CRON_SECRET=dev-only-change-me
