# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# embedded database (PGlite)
/.pglite

# local scratch
/tmp
*.local.json

# vercel
.vercel

# impeccable — design tooling installed per machine via `npx impeccable install`
# (settings.local.json is already covered by *.local.json above)
/.claude/skills/impeccable/
/.claude/agents/impeccable-*.md

# typescript
*.tsbuildinfo
next-env.d.ts
